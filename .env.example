# Wolfpaw environment template. Copy to `.env` and fill in.
#
# Variables not set here fall back to the defaults in src/wolfpaw/config.py.
# Anything documented as REQUIRED must be set before the app will work
# end-to-end; OPTIONAL is safe to leave unset (the relevant feature is
# disabled or runs in a dev / stub mode).
#
# Naming convention: every Wolfpaw env var is prefixed `WOLFPAW_`.

# ---------- REQUIRED for any agent work ----------

# Anthropic API key. Without this, the agent loop can't make model calls.
WOLFPAW_ANTHROPIC_API_KEY=

# Session + magic-link signing key. CHANGE THIS for any non-dev deployment
# (random 32+ bytes). The default in config.py is a placeholder that
# explicitly says "CHANGE-ME".
WOLFPAW_SECRET_KEY=

# ---------- Database (compose sets DATABASE_URL automatically) ----------

# Set this only if you run `docker compose up` with a non-default password.
# The compose file plumbs it into WOLFPAW_DATABASE_URL for app + migrate.
WOLFPAW_DB_PASSWORD=wolfpaw

# ---------- Background workers (step 23) ----------

# Whether to defer post-append (embed + thread compaction), Tasks, and
# Telegram/Slack inbound dispatch to the arq worker. Compose turns this
# on automatically; set "false" to run everything in-process (useful
# for debugging — no Redis required). Web SSE always runs in-process
# regardless of this flag.
WOLFPAW_WORKERS_ENABLED=true

# Redis URL used by the workers queue. Compose sets this to the `redis`
# service automatically; override here only if you run an external Redis.
WOLFPAW_REDIS_URL=redis://redis:6379/0

# ---------- Sleep Cycle (step 26) ----------

# Weekly maintenance job: re-scores old plans against the current
# Post-Evaluator prompts, consolidates near-duplicate emitted skills,
# and garbage-collects threads that never accumulated messages. The
# cron is always registered on the worker — flipping this flag enables
# the actual work without restarting. Defaults off because each run
# burns Haiku tokens for the re-score pass.
WOLFPAW_SLEEP_CYCLE_ENABLED=false

# ---------- Schedules ----------

# Scheduled tasks: the agent can register one-shot/recurring instructions
# (`schedule_task` tool) that a per-minute dispatcher turns into Tasks at
# their due time. The cron is always registered on the worker; flip this to
# enable dispatch. Defaults off because each firing re-runs the agent
# pipeline (recurring token spend). Requires WOLFPAW_WORKERS_ENABLED=true.
WOLFPAW_SCHEDULES_ENABLED=false
# Smallest allowed interval, in seconds. The dispatcher fires once a minute,
# so finer intervals can't be honored.
WOLFPAW_SCHEDULES_MIN_INTERVAL_SECONDS=60

# ---------- Web ----------

# Host port nginx publishes. The browser visits http://localhost:<port>.
WOLFPAW_WEB_PORT=3000

# Full origin the browser uses to hit the app. Magic-link verify URLs are
# constructed from this. Set to your real domain when you put nginx behind
# a reverse proxy with TLS.
WOLFPAW_WEB_BASE_URL=http://localhost:3000

# ---------- Email (magic link) ----------

# "console" prints the verify URL to the app's stdout (handy for dev).
# Operators wire a real backend by setting this + the EmailSender
# implementation in their fork. SES is the obvious choice; SMTP and
# Postmark are others.
WOLFPAW_EMAIL_BACKEND=console

# ---------- Embeddings ----------

# "voyage" uses Voyage AI (requires WOLFPAW_VOYAGE_API_KEY). "stub" is a
# deterministic SHA-based fallback for dev / CI without a Voyage key —
# fine for testing but useless for real retrieval quality.
WOLFPAW_EMBEDDING_BACKEND=stub
WOLFPAW_VOYAGE_API_KEY=

# ---------- Tools ----------

# Tavily (web search). Without this, the web_search tool returns an error.
WOLFPAW_TAVILY_API_KEY=

# ---------- Sandbox ----------

# "subprocess" is the OSS default. NOT a security boundary — runs Python
# in a subprocess inside the app container. Fine for single-user
# self-host where the user trusts their own agent. Multi-tenant
# deployments should switch to "e2b" (managed) or "docker" (DinD;
# requires extra setup).
WOLFPAW_SANDBOX_BACKEND=subprocess
WOLFPAW_E2B_API_KEY=

# ---------- Telegram (optional channel) ----------

# Leave blank to disable the Telegram channel. To enable: create a bot
# via @BotFather, set the token + username + a random webhook secret,
# then point Telegram at https://<your-domain>/channels/telegram/webhook
# (HTTPS required; use a reverse proxy with TLS in front of nginx).
WOLFPAW_TELEGRAM_BOT_TOKEN=
WOLFPAW_TELEGRAM_BOT_USERNAME=
WOLFPAW_TELEGRAM_WEBHOOK_SECRET=

# ---------- OAuth integrations (Phase C — optional) ----------

# Each integration is independent. Leave blank to disable; the
# install-url endpoint will return 503 and the agent's tools will
# surface "not connected" if the Planner picks them.

# Dropbox (step 29). Register an app at
# https://www.dropbox.com/developers/apps. Permission type: "App
# folder". Redirect URI:
# ${WOLFPAW_WEB_BASE_URL}/integrations/dropbox/oauth/callback.
WOLFPAW_DROPBOX_CLIENT_ID=
WOLFPAW_DROPBOX_CLIENT_SECRET=

# Notion (step 30). Create a public integration at
# https://www.notion.so/my-integrations. Redirect URI:
# ${WOLFPAW_WEB_BASE_URL}/integrations/notion/oauth/callback.
WOLFPAW_NOTION_CLIENT_ID=
WOLFPAW_NOTION_CLIENT_SECRET=

# Microsoft Calendar (step 32). Register an App registration in the
# Azure portal under Entra ID with a Web redirect:
# ${WOLFPAW_WEB_BASE_URL}/integrations/microsoft/oauth/callback. API
# permissions (delegated): Microsoft Graph Calendars.ReadWrite,
# offline_access, User.Read. Tenant defaults to "common" (any
# Microsoft account); pin to a specific tenant id for single-tenant
# deployments.
WOLFPAW_MICROSOFT_CLIENT_ID=
WOLFPAW_MICROSOFT_CLIENT_SECRET=
WOLFPAW_MICROSOFT_TENANT=common

# ---------- Slack (optional channel) ----------

# Leave blank to disable. To enable: create a Slack app from the
# manifest at docs/slack-app-manifest.yaml (Slack will auto-fill scopes
# + event subscriptions + slash command). Copy the Client ID, Client
# Secret, and Signing Secret from the Slack app's settings into these
# env vars. Like Telegram, Slack requires HTTPS at your domain for the
# webhook + OAuth callback URLs.
WOLFPAW_SLACK_CLIENT_ID=
WOLFPAW_SLACK_CLIENT_SECRET=
WOLFPAW_SLACK_SIGNING_SECRET=

# ---------- Observability (optional) ----------

# LangSmith tracing for model-call replay + prompt-version diffs.
WOLFPAW_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wolfpaw-dev

# ---------- Logging ----------

WOLFPAW_LOG_LEVEL=INFO
WOLFPAW_ENV=prod
