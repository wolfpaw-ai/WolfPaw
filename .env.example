# Wolfpaw environment template. Copy to `.env` and fill in.
# Unset vars fall back to defaults in src/wolfpaw/config.py.

# ---------- REQUIRED for any agent work ----------

# Anthropic API key. Without this the agent loop can't make model calls.
WOLFPAW_ANTHROPIC_API_KEY=

# Session + magic-link signing key. CHANGE for any non-dev deployment
# (random 32+ bytes).
WOLFPAW_SECRET_KEY=

# ---------- Database (compose sets DATABASE_URL automatically) ----------

# Only needed if you run compose with a non-default password.
WOLFPAW_DB_PASSWORD=wolfpaw

# ---------- Background workers ----------

# Defer embedding, compaction, Tasks, and channel dispatch to the arq
# worker. "false" runs everything in-process (no Redis needed).
WOLFPAW_WORKERS_ENABLED=true

# Workers queue Redis. Compose sets this; override for an external Redis.
WOLFPAW_REDIS_URL=redis://redis:6379/0

# ---------- Sleep Cycle ----------

# Weekly maintenance: re-score old plans, consolidate skills, GC empty
# threads. Off by default — each run burns Haiku tokens.
WOLFPAW_SLEEP_CYCLE_ENABLED=false

# ---------- Schedules ----------

# Dispatch scheduled tasks. Off by default — each firing re-runs the agent
# pipeline. Requires WOLFPAW_WORKERS_ENABLED=true.
WOLFPAW_SCHEDULES_ENABLED=false
# Dispatcher fires once a minute, so finer intervals can't be honored.
WOLFPAW_SCHEDULES_MIN_INTERVAL_SECONDS=60

# ---------- Web ----------

# Host port nginx publishes.
WOLFPAW_WEB_PORT=3000

# Origin the browser uses. Magic-link URLs are built from this — set it to
# your real domain when behind a TLS reverse proxy.
WOLFPAW_WEB_BASE_URL=http://localhost:3000

# ---------- Email (magic link) ----------

# "console" logs the verify URL to stdout. "ses" sends via Amazon SES and
# needs WOLFPAW_IMAGE_EXTRAS=ses plus a rebuild.
WOLFPAW_EMAIL_BACKEND=console

# Pip extras baked into the app image (comma-separated, no brackets).
# None by default. Changing this requires `docker compose up -d --build`.
WOLFPAW_IMAGE_EXTRAS=

# Used only when WOLFPAW_EMAIL_BACKEND=ses. Credentials come from the
# standard AWS chain — on EC2 use an instance role, not keys here.
WOLFPAW_SES_REGION=us-east-1
# Must be verified in SES, or under a verified domain. New SES accounts are
# sandboxed: recipients must be verified too, until you request production.
WOLFPAW_SES_FROM_EMAIL=
# Optional, for bounce/complaint tracking.
WOLFPAW_SES_CONFIGURATION_SET=

# ---------- Sign-in allowlist ----------

# Comma-separated addresses allowed to sign in; blank keeps sign-up open.
# Unlisted addresses get the same silent 202, so the list can't be probed.
WOLFPAW_ALLOWED_EMAILS=

# ---------- Embeddings ----------

# "voyage" needs WOLFPAW_VOYAGE_API_KEY. "stub" is a SHA-based fallback —
# fine for tests, useless for real retrieval.
WOLFPAW_EMBEDDING_BACKEND=stub
WOLFPAW_VOYAGE_API_KEY=

# ---------- Tools ----------

# Tavily (web search). Without it, the web_search tool errors.
WOLFPAW_TAVILY_API_KEY=

# ---------- Sandbox ----------

# "subprocess" is the OSS default and NOT a security boundary. Multi-tenant
# deployments should use "e2b" (managed) or "docker" (DinD).
WOLFPAW_SANDBOX_BACKEND=subprocess
WOLFPAW_E2B_API_KEY=

# ---------- Telegram (optional channel) ----------

# Blank disables. Create a bot via @BotFather, then point Telegram at
# https://<your-domain>/channels/telegram/webhook (HTTPS required).
WOLFPAW_TELEGRAM_BOT_TOKEN=
WOLFPAW_TELEGRAM_BOT_USERNAME=
WOLFPAW_TELEGRAM_WEBHOOK_SECRET=

# ---------- OAuth integrations (optional) ----------

# Each is independent. Blank disables: install-url returns 503 and the
# agent's tools report "not connected".

# Register at https://www.dropbox.com/developers/apps ("App folder").
# Redirect: ${WOLFPAW_WEB_BASE_URL}/integrations/dropbox/oauth/callback
WOLFPAW_DROPBOX_CLIENT_ID=
WOLFPAW_DROPBOX_CLIENT_SECRET=

# Create at https://www.notion.so/my-integrations.
# Redirect: ${WOLFPAW_WEB_BASE_URL}/integrations/notion/oauth/callback
WOLFPAW_NOTION_CLIENT_ID=
WOLFPAW_NOTION_CLIENT_SECRET=

# Entra ID app registration, Web redirect:
# ${WOLFPAW_WEB_BASE_URL}/integrations/microsoft/oauth/callback
# Delegated scopes: Calendars.ReadWrite, offline_access, User.Read.
WOLFPAW_MICROSOFT_CLIENT_ID=
WOLFPAW_MICROSOFT_CLIENT_SECRET=
WOLFPAW_MICROSOFT_TENANT=common

# ---------- Slack (optional channel) ----------

# Blank disables. Create the app from docs/slack-app-manifest.yaml, then
# copy its Client ID, Client Secret, and Signing Secret here. HTTPS required.
WOLFPAW_SLACK_CLIENT_ID=
WOLFPAW_SLACK_CLIENT_SECRET=
WOLFPAW_SLACK_SIGNING_SECRET=

# ---------- Observability (optional) ----------

# Per-call tracing to `model_call_logs` — the only record of FAILED model
# calls. Stays in your Postgres.
WOLFPAW_TRACE_SINK_ENABLED=true
# Enforced by dropping monthly partitions, so the cutoff rounds up to a
# month boundary. Requires the arq worker.
WOLFPAW_TRACE_RETENTION_DAYS=14
# Per-call cap on stored payload bytes; longer payloads are clipped.
WOLFPAW_TRACE_PAYLOAD_MAX_BYTES=64000

# ---------- Logging ----------

WOLFPAW_LOG_LEVEL=INFO
WOLFPAW_ENV=prod
